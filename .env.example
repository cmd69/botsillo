# ============================================
# Telegram
# ============================================
TELEGRAM_BOT_TOKEN=change-this-bot-token

# ============================================
# Expensivo — Conexion a DB (read-only)
# ============================================
DB_USER=expense_user
DB_PASSWORD=change-this-password
DB_HOST=expense_postgres_dev
DB_NAME=expense_db

# ============================================
# Expensivo — API Backend (escrituras)
# ============================================
API_BASE_URL=http://expense_backend_dev:8000

# ============================================
# Auth — Debe coincidir con SECRET_KEY de expensivo
# ============================================
SECRET_KEY=change-this-must-match-expensivo

# ============================================
# Web (enlaces en mensajes del bot; bienvenida, gasto guardado)
# ============================================
EXPENSIVE_WEB_URL=https://expensivo.altoke.top
